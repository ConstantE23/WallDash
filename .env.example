# Copy to .env.local and fill in from Supabase → Project Settings → API
# (or run `vercel env pull .env.local`; vite.config.ts also accepts the
# NEXT_PUBLIC_SUPABASE_* and SUPABASE_* names that Vercel injects).
#
# Only these two values are exposed to the browser. Never put the service
# role key or any POSTGRES_* URL behind a VITE_ prefix.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
